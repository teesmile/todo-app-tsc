# Copy to .env.local and fill in from the Supabase dashboard (Project Settings → API Keys).
# Both are public by design. Left empty, the app runs guest-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The Google OAuth client ID (public by design) for Google's own sign-in button.
# Left empty, sign-in uses the redirect flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
